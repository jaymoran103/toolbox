#!/usr/bin/env python3
"""Run timetools from a checkout. Linked as `timer`, `fireworks` and so on,
the link's name picks the tool."""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "py"))

from timetools.cli import main  # noqa: E402

sys.exit(main())
