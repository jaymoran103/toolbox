{
  "name": "ghostty-config",
  "about": "Ghostty's look and feel, kept as presets",
  "template": "preset-kit",
  "entries": [
    "bin/ghostty-config",
    "bin/ghostty-theme-edit",
    "bin/ghostty-theme"
  ],
  "links": {
    "presets/ghostty-config": "~/.config/ghostty-config/presets"
  },
  "needs": [
    "python3",
    "ghostty",
    "fzf"
  ],
  "shortcuts": {
    "theme": "ghostty-config theme",
    "font": "ghostty-config font-family",
    "font-size": "ghostty-config font-size",
    "opacity": "ghostty-config background-opacity"
  }
}
