#!/usr/bin/env python3
"""thumbs-batch: one branded thumbnail PNG per screenshot.

Usage:
  thumbs-batch [--frame DIR] SHOT NAME VERSION [SHOT NAME VERSION ...]
  thumbs-batch [--frame DIR] --list FILE
  thumbs-batch ... --upload            send each to its forge pin as its thumbnail

A frame is a folder holding frame.png (the frame, with a transparent window
where the screenshot shows) and frame.json (the window, the title and the
version: where each goes and how it looks). The default frame is the
Arcade's cart cover, tools/thumbs-batch/frames/cart.

The screenshot is fitted into the window (cropped to fill it), the frame
drawn over it, then the name and the version. A headless Chrome draws it,
so nothing else is needed: Chrome, Chromium, or $THUMBS_CHROME.

A list file has one thumbnail a line, tab-separated:
  SHOT<TAB>NAME<TAB>VERSION[<TAB>OWNER/REPO:LABEL]
The fourth column names the forge pin --upload sends it to. --upload reads
$FORGE_URL and $FORGE_TOKEN (a token with write scope) and makes each the
pin's first image, captioned Thumbnail, in place of the one before.

Writes into a new thumbs-<timestamp> directory under the current directory,
one <name>-<version>.png each.
"""

import base64, glob, json, os, re, shutil, subprocess, sys, tempfile, time, urllib.request, uuid

HERE = os.path.dirname(os.path.realpath(__file__))
DEFAULT_FRAME = os.path.join(HERE, "..", "tools", "thumbs-batch", "frames", "cart")


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def find_chrome():
    for env in ("THUMBS_CHROME", "FORGE_CHROMIUM"):
        p = os.environ.get(env)
        if p and os.path.exists(p):
            return p
    for p in (
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "/Applications/Chromium.app/Contents/MacOS/Chromium",
        *sorted(glob.glob(os.path.expanduser("~/Library/Caches/ms-playwright/chromium_headless_shell-*/*/chrome-headless-shell")), reverse=True),
        *sorted(glob.glob(os.path.expanduser("~/Library/Caches/ms-playwright/chromium-*/chrome-mac*/Chromium.app/Contents/MacOS/Chromium")), reverse=True),
    ):
        if os.path.exists(p):
            return p
    for name in ("chromium", "chromium-browser", "google-chrome", "chrome"):
        p = shutil.which(name)
        if p:
            return p
    die("No Chrome found: install Chrome, or set THUMBS_CHROME to a Chrome or Chromium binary.")


def data_url(path):
    ext = os.path.splitext(path)[1].lower()
    mime = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".webp": "image/webp"}.get(ext)
    if mime is None:
        die(f"Not a PNG, JPEG or WebP picture: {path}")
    with open(path, "rb") as f:
        return f"data:{mime};base64," + base64.b64encode(f.read()).decode()


def short_version(v):
    """As the Arcade's covers write it: up to four characters as they are, else the number it ends with."""
    if len(v) <= 4:
        return v
    m = re.search(r"(\d+(?:\.\d+)?)$", v)
    return m.group(1) if m else ""


DRAW = r"""
(async function () {
  function load(src) { return new Promise(function (ok) { var i = new Image(); i.onload = function () { ok(i); }; i.onerror = function () { ok(null); }; i.src = src; }); }
  var F = SPEC, c = document.getElementById('c'), x = c.getContext('2d'), S = F.size;
  x.fillStyle = F.background || '#000'; x.fillRect(0, 0, S, S);
  var shot = await load(SHOT), frame = await load(FRAME), w = F.window;
  if (shot) {
    var k = Math.max(w.w / shot.naturalWidth, w.h / shot.naturalHeight), sw = w.w / k, sh = w.h / k;
    x.imageSmoothingEnabled = true; x.imageSmoothingQuality = 'high';
    x.drawImage(shot, (shot.naturalWidth - sw) / 2, (shot.naturalHeight - sh) / 2, sw, sh, w.x, w.y, w.w, w.h);
  }
  if (frame) x.drawImage(frame, 0, 0, S, S);
  function text(t, spec, y) {
    x.font = spec.font; x.textAlign = spec.align || 'left'; x.textBaseline = 'alphabetic'; x.lineJoin = 'round';
    if (spec.stroke) { x.lineWidth = spec.strokeWidth || 4; x.strokeStyle = spec.stroke; x.strokeText(t, spec.x, y); }
    x.fillStyle = spec.fill || '#fff'; x.fillText(t, spec.x, y);
  }
  if (F.title) LINES.forEach(function (line, n) { text(line, F.title, F.title.y + n * (F.title.lineHeight || 0)); });
  if (F.version && VERSION) text(VERSION, F.version, F.version.y);
  document.title = 'drawn';
})();
"""


def title_lines(name, spec):
    sep = spec.get("split") if spec else None
    if not sep or sep not in name:
        return [name]
    parts = name.split(sep)
    return [sep.join(parts[:-1]), parts[-1]]


def render(chrome, frame_dir, spec, shot, name, version, out):
    page_js = (
        DRAW.replace("SPEC", json.dumps(spec))
        .replace("SHOT", json.dumps(data_url(shot)))
        .replace("FRAME", json.dumps(data_url(os.path.join(frame_dir, "frame.png"))))
        .replace("LINES", json.dumps(title_lines(name, spec.get("title"))))
        .replace("VERSION", json.dumps(short_version(version) if spec.get("version", {}).get("short") else version))
    )
    size = int(spec["size"])
    with tempfile.TemporaryDirectory() as tmp:
        page = os.path.join(tmp, "thumb.html")
        with open(page, "w") as f:
            f.write(f'<!doctype html><meta charset="utf-8"><style>html,body{{margin:0;background:transparent;overflow:hidden}}canvas{{display:block}}</style><canvas id="c" width="{size}" height="{size}"></canvas><script>{page_js}</script>')
        run = subprocess.run(
            [chrome, "--headless=new", "--disable-gpu", "--hide-scrollbars", "--no-first-run", f"--user-data-dir={tmp}/profile",
             "--force-device-scale-factor=1", f"--window-size={size},{size}", "--virtual-time-budget=4000",
             "--default-background-color=00000000", f"--screenshot={out}", "file://" + page],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=60,
        )
    if not os.path.exists(out):
        die(f"Chrome drew nothing for {shot}: {run.stderr.decode(errors='replace')[-300:]}")


def upload(path, pin):
    base, token = os.environ.get("FORGE_URL"), os.environ.get("FORGE_TOKEN")
    if not base or not token:
        die("--upload needs FORGE_URL (like http://localhost:3001) and FORGE_TOKEN (write scope).")
    m = re.fullmatch(r"([^/\s]+)/([^/\s:]+):(\S+)", pin or "")
    if not m:
        die(f"--upload needs OWNER/REPO:LABEL in the list's fourth column, not {pin!r}.")
    owner, repo, label = m.groups()
    edge = uuid.uuid4().hex
    with open(path, "rb") as f:
        png = f.read()
    body = b"".join([
        f"--{edge}\r\nContent-Disposition: form-data; name=\"thumbnail\"\r\n\r\n1\r\n".encode(),
        f"--{edge}\r\nContent-Disposition: form-data; name=\"shot\"; filename=\"thumbnail.png\"\r\nContent-Type: image/png\r\n\r\n".encode(),
        png, f"\r\n--{edge}--\r\n".encode(),
    ])
    req = urllib.request.Request(
        f"{base.rstrip('/')}/api/v1/repos/{owner}/{repo}/builds/{label}/shots", data=body, method="POST",
        headers={"Authorization": f"Bearer {token}", "Content-Type": f"multipart/form-data; boundary={edge}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return r.status
    except urllib.error.HTTPError as e:
        return f"{e.code} {e.read().decode(errors='replace')[:200]}"


def main(argv):
    frame_dir, list_file, send, rest = DEFAULT_FRAME, None, False, []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip()); return
        if a == "--frame": frame_dir = argv[i + 1]; i += 2; continue
        if a == "--list": list_file = argv[i + 1]; i += 2; continue
        if a == "--upload": send = True; i += 1; continue
        rest.append(a); i += 1
    frame_dir = os.path.realpath(frame_dir)
    for need in ("frame.png", "frame.json"):
        if not os.path.exists(os.path.join(frame_dir, need)):
            die(f"No {need} in {frame_dir}: a frame is a folder with frame.png and frame.json.")
    with open(os.path.join(frame_dir, "frame.json")) as f:
        spec = json.load(f)
    jobs = []
    if list_file:
        with open(list_file) as f:
            for n, line in enumerate(f, 1):
                if not line.strip() or line.startswith("#"):
                    continue
                cols = line.rstrip("\n").split("\t")
                if len(cols) < 3:
                    die(f"{list_file}:{n}: want SHOT<TAB>NAME<TAB>VERSION[<TAB>OWNER/REPO:LABEL]")
                shot = cols[0] if os.path.isabs(cols[0]) else os.path.join(os.path.dirname(os.path.realpath(list_file)), cols[0])
                jobs.append((shot, cols[1], cols[2], cols[3] if len(cols) > 3 else None))
    if len(rest) % 3:
        die("Give each thumbnail as SHOT NAME VERSION, or use --list FILE. thumbs-batch -h for more.")
    jobs += [(rest[k], rest[k + 1], rest[k + 2], None) for k in range(0, len(rest), 3)]
    if not jobs:
        die("Nothing to draw. thumbs-batch -h for usage.")
    chrome = find_chrome()
    outdir = time.strftime("thumbs-%Y%m%d-%H%M%S")
    os.mkdir(outdir)
    for shot, name, version, pin in jobs:
        if not os.path.exists(shot):
            print(f"failed: no screenshot at {shot}", file=sys.stderr); continue
        safe = re.sub(r"[^A-Za-z0-9._-]+", "-", f"{name}-{version}").strip("-")
        out = os.path.join(outdir, f"{safe}.png")
        render(chrome, frame_dir, spec, shot, name, version, out)
        said = f"wrote {out}"
        if send:
            said += f", sent to {pin}: {upload(out, pin)}"
        print(said)


if __name__ == "__main__":
    main(sys.argv[1:])
