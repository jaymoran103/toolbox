#!/usr/bin/env python3
"""starship-config — what your Starship prompt shows, kept as presets.

A preset starts from a base config and picks which modules show, in what
order. The base is your own config, no config, or one of Starship's
built-in presets, and it gives the modules their look. The preview draws
the real prompt for the directory you started in, and each module's row
shows what it prints there.

Using a preset writes ~/.local/state/starship-config/active.toml. The zsh
hook, tools/starship-config/starship-config.zsh, points STARSHIP_CONFIG at
it before every prompt, so open shells switch on their next prompt.

  starship-config -H ...   the same commands, for this project only: the git
                           top level, or this folder. A project pick beats
                           the everywhere pick, and -H -r drops it.
"""

import json
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from preset_kit import BG, DIM, Element, Tool, lch_hex, main, ramp  # noqa: E402

HOME = os.path.expanduser("~")
YOUR_CONFIG = os.path.join(HOME, ".config", "starship.toml")
HERE = os.environ.get("STARSHIP_PRESET_HERE") or os.getcwd()
# The modules worth listing, in a sensible default order. Starship has more.
MODULES = (
    ("os", "OS icon"), ("username", "user"), ("hostname", "host"), ("localip", "local IP"),
    ("directory", "directory"), ("git_branch", "git branch"), ("git_commit", "git commit"),
    ("git_state", "git state"), ("git_status", "git status"), ("git_metrics", "git +/− lines"),
    ("package", "package version"), ("nodejs", "Node"), ("bun", "Bun"), ("deno", "Deno"),
    ("python", "Python"), ("conda", "conda env"), ("rust", "Rust"), ("golang", "Go"),
    ("java", "Java"), ("ruby", "Ruby"), ("docker_context", "Docker context"),
    ("kubernetes", "Kubernetes"), ("aws", "AWS"), ("gcloud", "gcloud"), ("nix_shell", "nix shell"),
    ("memory_usage", "memory"), ("battery", "battery"), ("cmd_duration", "command time"),
    ("jobs", "background jobs"), ("status", "exit status"), ("sudo", "sudo"), ("shell", "shell name"),
    ("time", "clock"), ("fill", "fill to the right"), ("line_break", "line break"),
    ("character", "prompt character"),
)


# --- configs ------------------------------------------------------------------------

def run(*args, **kw):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=10, **kw)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


_bases = None


def base_names():
    global _bases
    if _bases is None:
        _bases = ["your config", "none"] + (run("starship", "preset", "--list") or "").split()
    return _bases


def base_text(base):
    if base in (None, "your config"):
        try:
            with open(YOUR_CONFIG) as f:
                return f.read()
        except OSError:
            return ""
    if base == "none":
        return ""
    return run("starship", "preset", base) or ""


def strip_top(text, keys):
    """text without the top-level `keys`, multi-line strings and all. Lines
    inside any multi-line string never count as table headings."""
    out, open_q, dropping, in_table = [], None, False, False
    for line in text.splitlines():
        if open_q:
            if open_q in line:
                open_q = None
            if not dropping:
                out.append(line)
            continue
        s = line.strip()
        if s.startswith("["):
            in_table = True
        m = re.match(r"([A-Za-z0-9_-]+)\s*=\s*(.*)", s)
        drop = bool(m and not in_table and m.group(1) in keys)
        if m:
            for q in ('"""', "'''"):
                if m.group(2).startswith(q) and m.group(2).count(q) == 1:
                    open_q, dropping = q, drop
        if not drop:
            out.append(line)
    return "\n".join(out) + "\n"


# Modules with nothing to colour.
UNSTYLED = {"line_break", "fill"}


def set_keys(text, table, keys):
    """text with `keys` set inside [table]: an existing line replaced, a
    missing one added under the heading, a missing table added at the end.
    Lines inside multi-line strings are left alone."""
    lines, out, open_q, inside, done = text.splitlines(), [], None, False, set()
    dropping = False
    for line in lines:
        if open_q:
            if open_q in line:
                open_q = None
            if not dropping:
                out.append(line)
            continue
        dropping = False
        s = line.strip()
        if s.startswith("["):
            if inside:
                blank = 0
                while out and not out[-1].strip():
                    out.pop()
                    blank += 1
                out += [f"{k} = {v}" for k, v in keys.items() if k not in done] + [""] * blank
                done.update(keys)
            inside = s == f"[{table}]"
            out.append(line)
            continue
        m = re.match(r"([A-Za-z0-9_-]+)\s*=\s*(.*)", s)
        if m:
            for q in ('"""', "'''"):
                if m.group(2).startswith(q) and m.group(2).count(q) == 1:
                    open_q = q
        if inside and m and m.group(1) in keys:
            out.append(f"{m.group(1)} = {keys[m.group(1)]}")
            done.add(m.group(1))
            dropping = True           # an old multi-line value's lines go with it
            continue
        out.append(line)
    if inside:
        out += [f"{k} = {v}" for k, v in keys.items() if k not in done]
        done.update(keys)
    if not done:
        out += ["", f"[{table}]"] + [f"{k} = {v}" for k, v in keys.items()]
    return "\n".join(out) + "\n"


# --- the tool -------------------------------------------------------------------

class StarshipPreset(Tool):
    name = "starship-config"
    title = "what your Starship prompt shows"
    pickup = "open shells switch on their next prompt"
    elements = tuple(Element(k, label) for k, label in MODULES) + (
        Element("base", "base config", kind="choice", choices=base_names, optional=True),
        Element("add_newline", "blank line before", kind="choice", choices=("true", "false"), optional=True),
        # One hue: set a hue, and each shown module takes the next of evenly
        # spaced OKLCH lightness steps from `lightness first` to `lightness last`.
        Element("hue", "one hue", kind="number", lo=0, hi=359, step=5, optional=True, default=195,
                note="unset keeps the base's colours"),
        Element("strength", "colour strength %", kind="number", lo=0, hi=100, step=5, optional=True, default=70),
        Element("light-first", "lightness first", kind="number", lo=20, hi=95, step=1, optional=True, default=85),
        Element("light-last", "lightness last", kind="number", lo=20, hi=95, step=1, optional=True, default=55),
        Element("bold", "bold", kind="choice", choices=("true", "false"), optional=True),
    )
    builtins = {
        "default": {},
        "minimal": {"show": ["directory", "git_branch", "character"], "set": {"add_newline": "false"}},
        "two-line": {"show": ["directory", "git_branch", "git_status", "cmd_duration", "line_break", "character"]},
        "full": {"show": ["username", "hostname", "directory", "git_branch", "git_status", "package", "nodejs",
                          "python", "rust", "golang", "cmd_duration", "jobs", "fill", "time", "line_break",
                          "character"]},
        "one-hue": {"show": ["directory", "git_branch", "git_status", "cmd_duration", "character"],
                    "set": {"hue": 195, "strength": 70, "light-first": 85, "light-last": 55, "bold": "true"}},
    }
    builtins.update({n: {"set": {"base": n}} for n in (run("starship", "preset", "--list") or "").split()})
    scope = None          # a project folder, under -H

    # --- picks, everywhere or per project ------------------------------------------

    def file(self, name):
        return os.path.join(self.state_dir, name)

    def read_lines(self, name):
        try:
            with open(self.file(name)) as f:
                return [ln.rstrip("\n").split("\t") for ln in f if "\t" in ln]
        except OSError:
            return []

    def write_lines(self, name, rows):
        os.makedirs(self.state_dir, exist_ok=True)
        with open(self.file(name), "w") as f:
            f.writelines("\t".join(r) + "\n" for r in rows)

    @property
    def draft_path(self):
        if self.scope:
            return self.file("draft-" + self.slug() + ".json")
        return super().draft_path

    def slug(self):
        return re.sub(r"[^A-Za-z0-9]+", "-", self.scope).strip("-")

    def active(self):
        if self.scope:
            mine = dict(self.read_lines("project-picks")).get(self.scope)
            if mine and self.source(mine):
                return mine
        return super().active()

    def set_active(self, name):
        if not self.scope:
            return super().set_active(name)
        self.drop_draft()
        self.applied(name, self.load(name))

    def config_file(self, name, preset):
        """Write the preset's config and return its path."""
        slug = "active" if not self.scope else "project-" + self.slug()
        path = self.file(slug + ".toml")
        os.makedirs(self.state_dir, exist_ok=True)
        with open(path, "w") as f:
            f.write(f"# Written by starship-config from preset {name}. Edit the preset, not this file.\n")
            f.write(self.text(preset))
        return path

    def text(self, preset):
        s, show = preset["set"], preset["show"]
        base = base_text(s.get("base"))
        drop = (["format"] if show else []) + (["add_newline"] if s.get("add_newline") else [])
        head = ""
        if show:
            head += 'format = "' + "".join(f"${m}" for m in show) + '"\n'
        if s.get("add_newline"):
            head += f"add_newline = {s['add_newline']}\n"
        text = head + strip_top(base, drop) if drop else head + base
        for module, keys in self.styles(preset).items():
            text = set_keys(text, module, keys)
        return text

    def steps(self, preset):
        """(module, hex) for each shown module that takes a colour, in order."""
        s = preset["set"]
        if s.get("hue") is None:
            return []
        mods = [m for m in preset["show"] if m not in UNSTYLED]
        val = lambda k: s.get(k) if s.get(k) is not None else self.element(k).default
        lights = ramp(len(mods), val("light-first"), val("light-last"))
        return [(m, lch_hex(L, val("strength"), s["hue"])) for m, L in zip(mods, lights)]

    def styles(self, preset):
        weight = "" if preset["set"].get("bold") == "false" else "bold "
        out = {}
        for m, colour in self.steps(preset):
            if m == "character":
                out[m] = {"success_symbol": f'"[❯]({weight}{colour})"'}
            else:
                out[m] = {"style": f'"{weight}{colour}"'}
        return out

    def applied(self, name, preset):
        if self.scope:
            picks = [r for r in self.read_lines("project-picks") if r[0] != self.scope]
            paths = [r for r in self.read_lines("projects") if r[0] != self.scope]
            if name != self.default or preset != self.load(name):
                picks.append([self.scope, name])
                paths.append([self.scope, self.config_file(name, preset)])
            self.write_lines("project-picks", picks)
            self.write_lines("projects", paths)
            return
        path = self.file("global")
        if name == self.default and not preset["show"] and not any(preset["set"].values()):
            try:
                os.remove(path)        # your own config, as it is
            except OSError:
                pass
            return
        os.makedirs(self.state_dir, exist_ok=True)
        with open(path, "w") as f:
            f.write(self.config_file(name, preset) + "\n")

    # --- preview --------------------------------------------------------------

    def prompt(self, preset, *args, width=80):
        tmp = self.file(".preview.toml")
        os.makedirs(self.state_dir, exist_ok=True)
        with open(tmp, "w") as f:
            f.write(self.text(preset))
        env = {k: v for k, v in os.environ.items() if k != "STARSHIP_SHELL"}
        env.update(STARSHIP_CONFIG=tmp, PWD=HERE)
        return run("starship", *args, "-p", HERE, "-w", str(width), cwd=HERE, env=env) or ""

    _values = {}

    def value(self, key):
        if key not in dict(MODULES):
            return ""
        if key not in self._values:
            out = self.prompt({"show": [], "set": {}}, "module", key)
            self._values[key] = re.sub(r"\x1b\[[0-9;]*m", "", out).strip()
        return self._values[key]

    _rendered = {}

    def render(self, preset, width):
        mark = json.dumps(preset, sort_keys=True) + str(width)
        if mark not in self._rendered:
            left = self.prompt(preset, "prompt", width=width).strip("\n").split("\n")
            right = self.prompt(preset, "prompt", "--right", width=width).strip()
            failed = self.prompt(preset, "prompt", "-s", "1", "-d", "4000", width=width).strip("\n").split("\n")
            out = [DIM + "here\x1b[0m"] + left
            if right:
                out += [DIM + "right:\x1b[0m " + right]
            out += ["", DIM + "after a failed 4s command\x1b[0m"] + failed + [""]
            base = preset["set"].get("base") or "your config"
            out.append(DIM + f"base: {base}" + (" · your module order" if preset["show"] else " · its own order")
                       + "\x1b[0m")
            steps = self.steps(preset)
            if steps:
                out += ["", DIM + f"one hue · {preset['set']['hue']}°, lightness steps first to last\x1b[0m"]
                out += [f"{BG(c)}    \x1b[0m {m:<14} {c}" for m, c in steps]
            self._rendered[mark] = out
        return self._rendered[mark]


def project_dir():
    top = run("git", "-C", HERE, "rev-parse", "--show-toplevel")
    return top.strip() if top else os.path.realpath(HERE)


if __name__ == "__main__":
    tool, argv = StarshipPreset(), sys.argv[1:]
    if argv[:1] in (["-H"], ["--here"]):
        tool.scope, argv = project_dir(), argv[1:]
        tool.title = f"this project only · {tool.scope.replace(HOME, '~', 1)}"
    main(tool, argv)
